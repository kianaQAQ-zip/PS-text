<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    ==========  (分隔线)  ==========
    深色主题 · 设计令牌
    ==========  (分隔线)  ==========
    键名必须与 Theme.Light.xaml 完全一致（切换主题靠同名覆盖）。
    改动配色时请两个文件一起改，并运行 selftest 模式里的主题用例校验。
  -->

  <!-- 背景层 -->
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF1E1E1E" />
  <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FF252526" />
  <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FF1B1B1C" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FF3F3F46" />


  <!-- 前景色 -->
  <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#FFF0F0F0" />
  <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FFA0A0A0" />

  <!-- 强调色与交互态 -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FF4C9AFF" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#33FFFFFF" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#44FFFFFF" />
  <SolidColorBrush x:Key="PrimaryHoverBorderBrush" Color="#55FFFFFF" />
  <SolidColorBrush x:Key="PrimarySelectedBrush" Color="#554C9AFF" />

  <!-- 遮罩 -->
  <SolidColorBrush x:Key="OverlayBrush" Color="#B2000000" />
  <SolidColorBrush x:Key="CropMaskBrush" Color="#AA000000" />

  <!-- 修补标记（红色半透明，两套主题共用同一组值：标记必须一眼可见） -->
  <SolidColorBrush x:Key="RetouchMaskFillBrush" Color="#44E24B4A" />
  <SolidColorBrush x:Key="RetouchMaskStrokeBrush" Color="#FFE24B4A" />

  <!-- 棋盘格（深色主题用深灰） -->
  <SolidColorBrush x:Key="CheckerLightBrush" Color="#FF565656" />
  <SolidColorBrush x:Key="CheckerDarkBrush" Color="#FF4A4A4A" />

  <!-- 辅助线 -->
  <SolidColorBrush x:Key="GuideBrush" Color="#CCFFFFFF" />
  <SolidColorBrush x:Key="PrintableAreaBrush" Color="#5566A8FF" />
</ResourceDictionary>
