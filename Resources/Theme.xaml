<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    应用级共享资源与控件样式。
    说明：与主题无关的结构放在这里；所有颜色一律通过 DynamicResource 引用
          Theme.Light.xaml / Theme.Dark.xaml 中的同名令牌，因此切换主题时自动生效。
    新增颜色时请在两个主题文件里同时定义同名键，不要在这里写死色值。
  -->

  <!-- 工具栏按钮 -->
  <Style x:Key="ToolbarButtonStyle" TargetType="Button">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="Button">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource PrimaryHoverBorderBrush}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryPressedBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
              <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 工具栏切换按钮（抓手工具等） -->
  <Style x:Key="ToolbarToggleButtonStyle" TargetType="ToggleButton">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="MinWidth" Value="64" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="ToggleButton">
          <Border x:Name="Root"
                  Background="{TemplateBinding Background}"
                  BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="{TemplateBinding BorderThickness}"
                  CornerRadius="3"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center"
                              RecognizesAccessKey="True" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimarySelectedBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 状态栏文字 -->
  <Style x:Key="StatusTextStyle" TargetType="TextBlock">
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Margin" Value="8,0" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="TextTrimming" Value="CharacterEllipsis" />
  </Style>

  <Style x:Key="StatusLabelStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
    <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
  </Style>

  <!-- 工具栏分隔线（Separator 在 Win7 默认模板下会占满高度，这里改用细矩形） -->
  <Style x:Key="ToolbarSeparatorStyle" TargetType="Rectangle">
    <Setter Property="Width" Value="1" />
    <Setter Property="Margin" Value="6,4" />
    <Setter Property="Fill" Value="{DynamicResource BorderBrush}" />
  </Style>

  <!-- 单选式按钮（布局模式 / 缩放模式等），共享同一 GroupName -->
  <Style x:Key="ModeRadioStyle" TargetType="RadioButton">
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="Margin" Value="2,0" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Template">
      <Setter.Value>
        <ControlTemplate TargetType="RadioButton">
          <Border x:Name="Root"
                  Background="Transparent"
                  BorderBrush="Transparent"
                  BorderThickness="1"
                  CornerRadius="3"
                  SnapsToDevicePixels="True">
            <ContentPresenter Margin="{TemplateBinding Padding}"
                              HorizontalAlignment="Center"
                              VerticalAlignment="Center" />
          </Border>
          <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimaryHoverBrush}" />
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
              <Setter TargetName="Root" Property="Background" Value="{DynamicResource PrimarySelectedBrush}" />
              <Setter TargetName="Root" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
              <Setter Property="Opacity" Value="0.4" />
            </Trigger>
          </ControlTemplate.Triggers>
        </ControlTemplate>
      </Setter.Value>
    </Setter>
  </Style>

  <!-- 分页标题（TabItem）用的简洁样式：跟随主题前景色 -->
  <Style x:Key="PanelTabItemStyle" TargetType="TabItem">
    <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
    <Setter Property="Padding" Value="10,4" />
  </Style>

  <!-- 棋盘格画布背景（透明图片可辨识）；色值来自主题令牌 -->
  <DrawingBrush x:Key="CheckerboardBrush" TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
    <DrawingBrush.Drawing>
      <DrawingGroup>
        <GeometryDrawing Brush="{DynamicResource CheckerLightBrush}">
          <GeometryDrawing.Geometry>
            <RectangleGeometry Rect="0,0,16,16" />
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
        <GeometryDrawing Brush="{DynamicResource CheckerDarkBrush}">
          <GeometryDrawing.Geometry>
            <GeometryGroup>
              <RectangleGeometry Rect="0,0,8,8" />
              <RectangleGeometry Rect="8,8,8,8" />
            </GeometryGroup>
          </GeometryDrawing.Geometry>
        </GeometryDrawing>
      </DrawingGroup>
    </DrawingBrush.Drawing>
  </DrawingBrush>
</ResourceDictionary>
