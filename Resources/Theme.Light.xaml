<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <!--
    ==========  (分隔线)  ==========
    浅色主题 · 设计令牌（Design Tokens）
    ==========  (分隔线)  ==========
    命名约定（与 MaterialDesign 的语义化配色保持一致，便于将来替换实现）：
      Surface*     背景层：画布 / 工具栏 / 状态栏
      Border*      分隔线
      OnSurface*   前景色（正常 / 次要）
      Primary*     强调色及其交互态（Hover / Pressed / Selected）
      Overlay*     遮罩（加载中、裁剪遮罩）
      Checker*     透明图片的棋盘格底纹
      Guide*       裁剪三分线等辅助线

    规则：所有键都必须在 Theme.Dark.xaml 中存在同名定义，
          否则切换主题时该处会保留旧值。
  -->

  <!-- 背景层 -->
  <SolidColorBrush x:Key="CanvasBackgroundBrush" Color="#FF3A3A3A" />
  <SolidColorBrush x:Key="ChromeBackgroundBrush" Color="#FFF3F3F3" />
  <SolidColorBrush x:Key="StatusBarBackgroundBrush" Color="#FFEDEDED" />
  <SolidColorBrush x:Key="BorderBrush" Color="#FFD6D6D6" />


  <!-- 前景色 -->
  <SolidColorBrush x:Key="ChromeForegroundBrush" Color="#FF1F1F1F" />
  <SolidColorBrush x:Key="SubtleForegroundBrush" Color="#FF6B6B6B" />

  <!-- 强调色与交互态 -->
  <SolidColorBrush x:Key="AccentBrush" Color="#FF1E6FD9" />
  <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#22808080" />
  <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#33808080" />
  <SolidColorBrush x:Key="PrimaryHoverBorderBrush" Color="#55808080" />
  <SolidColorBrush x:Key="PrimarySelectedBrush" Color="#441E6FD9" />

  <!-- 遮罩 -->
  <SolidColorBrush x:Key="OverlayBrush" Color="#B2000000" />
  <SolidColorBrush x:Key="CropMaskBrush" Color="#99000000" />

  <!-- 修补标记（红色半透明，两套主题共用同一组值：标记必须一眼可见） -->
  <SolidColorBrush x:Key="RetouchMaskFillBrush" Color="#44E24B4A" />
  <SolidColorBrush x:Key="RetouchMaskStrokeBrush" Color="#FFE24B4A" />

  <!-- 棋盘格（浅色主题用浅灰，避免深色底纹） -->
  <SolidColorBrush x:Key="CheckerLightBrush" Color="#FFF0F0F0" />
  <SolidColorBrush x:Key="CheckerDarkBrush" Color="#FFE0E0E0" />

  <!-- 辅助线 -->
  <SolidColorBrush x:Key="GuideBrush" Color="#CC333333" />
  <SolidColorBrush x:Key="PrintableAreaBrush" Color="#55338099" />
</ResourceDictionary>
