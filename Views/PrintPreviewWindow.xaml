<Window x:Class="PSText.Views.PrintPreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PSText.Infrastructure.Converters"
        Title="{Binding PrinterName, StringFormat=打印预览 - {0}}"
        Width="1080"
        Height="760"
        MinWidth="680"
        MinHeight="480"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource ChromeBackgroundBrush}"
        Foreground="{DynamicResource ChromeForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        UseLayoutRounding="True">

  <Window.Resources>
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:EnumEqualsConverter x:Key="EnumEquals" />
    <conv:StringToVisibilityConverter x:Key="StringToVisibility" />
  </Window.Resources>

  <DockPanel>

    <!-- ==================== 顶部：布局模式与缩放 ==================== -->
    <Border DockPanel.Dock="Top"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False" Margin="8,6">

        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <TextBlock Text="布局" Style="{StaticResource StatusLabelStyle}" />
          <RadioButton Content="居中" GroupName="PrintMode" Margin="4,0"
                       Style="{StaticResource ModeRadioStyle}"
                       IsChecked="{Binding LayoutMode, Converter={StaticResource EnumEquals}, ConverterParameter=Center, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="Center" />
          <RadioButton Content="填充" GroupName="PrintMode" Margin="4,0"
                       Style="{StaticResource ModeRadioStyle}"
                       IsChecked="{Binding LayoutMode, Converter={StaticResource EnumEquals}, ConverterParameter=Fill, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="Fill" />
          <RadioButton Content="适应" GroupName="PrintMode" Margin="4,0"
                       Style="{StaticResource ModeRadioStyle}"
                       IsChecked="{Binding LayoutMode, Converter={StaticResource EnumEquals}, ConverterParameter=Fit, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="Fit" />
          <RadioButton Content="原始尺寸" GroupName="PrintMode" Margin="4,0"
                       Style="{StaticResource ModeRadioStyle}"
                       IsChecked="{Binding LayoutMode, Converter={StaticResource EnumEquals}, ConverterParameter=OriginalSize, Mode=OneWay}"
                       Command="{Binding SetLayoutModeCommand}" CommandParameter="OriginalSize" />
        </StackPanel>

        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <TextBlock Text="缩放" Style="{StaticResource StatusLabelStyle}" />
          <Button Content="－" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                  Command="{Binding ZoomOutCommand}" />
          <TextBlock Text="{Binding ScaleText}" MinWidth="52" TextAlignment="Center"
                     Style="{StaticResource StatusTextStyle}" />
          <Button Content="＋" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                  Command="{Binding ZoomInCommand}" />
          <Button Content="重置" Style="{StaticResource ToolbarButtonStyle}"
                  Command="{Binding ResetCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ==================== 底部：信息与操作 ==================== -->
    <Border DockPanel.Dock="Bottom"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="8,6">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Column="0">
          <TextBlock Text="{Binding WarningText}" TextWrapping="Wrap" FontSize="11"
                     Foreground="{DynamicResource AccentBrush}"
                     Visibility="{Binding WarningText, Converter={StaticResource StringToVisibility}}" />
          <StackPanel Orientation="Horizontal" Margin="0,4,0,0">
            <TextBlock Text="页数" Style="{StaticResource StatusLabelStyle}" />
            <TextBlock Text="{Binding PageText}" Style="{StaticResource StatusTextStyle}" />
            <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" Margin="4,5" />
            <TextBlock Text="打印分辨率" Style="{StaticResource StatusLabelStyle}" />
            <TextBlock Text="{Binding EffectiveDpiText}" Style="{StaticResource StatusTextStyle}" />
          </StackPanel>
        </StackPanel>

        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Bottom">
          <TextBlock Text="在预览中按住图像可拖动位置，滚轮也可缩放" FontSize="11"
                     VerticalAlignment="Center" Margin="0,0,12,0"
                     Foreground="{DynamicResource SubtleForegroundBrush}" />
          <Button Content="打印" Style="{StaticResource ToolbarButtonStyle}"
                  MinWidth="72" Click="OnPrintClick" />
          <Button Content="取消" Style="{StaticResource ToolbarButtonStyle}"
                  MinWidth="72" Click="OnCancelClick" />
        </StackPanel>
      </Grid>
    </Border>

    <!-- ==================== 预览区 ==================== -->
    <ScrollViewer x:Name="PreviewScroll"
                  HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto"
                  Background="{DynamicResource CanvasBackgroundBrush}"
                  SizeChanged="OnPreviewSizeChanged">
      <Canvas x:Name="PreviewCanvas"
              HorizontalAlignment="Center"
              VerticalAlignment="Center"
              Background="Transparent">

        <!-- 纸张 -->
        <Border Canvas.Left="0" Canvas.Top="0"
                Width="{Binding DisplayPaperWidth}"
                Height="{Binding DisplayPaperHeight}"
                Background="White"
                BorderBrush="{DynamicResource BorderBrush}"
                BorderThickness="1">
          <Border.Effect>
            <DropShadowEffect BlurRadius="12" ShadowDepth="2" Opacity="0.35" Color="Black" />
          </Border.Effect>
        </Border>

        <!-- 可打印区域（虚线提示硬边距） -->
        <Rectangle Canvas.Left="{Binding DisplayPrintableBounds.X}"
                   Canvas.Top="{Binding DisplayPrintableBounds.Y}"
                   Width="{Binding DisplayPrintableBounds.Width}"
                   Height="{Binding DisplayPrintableBounds.Height}"
                   Stroke="{DynamicResource PrintableAreaBrush}"
                   StrokeThickness="1" StrokeDashArray="3 3"
                   IsHitTestVisible="False" />

        <!-- 图像本体（可拖动） -->
        <Image x:Name="PreviewImage"
               Canvas.Left="{Binding DisplayImageBounds.X}"
               Canvas.Top="{Binding DisplayImageBounds.Y}"
               Width="{Binding DisplayImageBounds.Width}"
               Height="{Binding DisplayImageBounds.Height}"
               Source="{Binding Bitmap}"
               Stretch="Fill"
               RenderOptions.BitmapScalingMode="HighQuality"
               Cursor="SizeAll"
               MouseLeftButtonDown="OnImageMouseDown"
               MouseMove="OnImageMouseMove"
               MouseLeftButtonUp="OnImageMouseUp" />
      </Canvas>
    </ScrollViewer>
  </DockPanel>
</Window>
