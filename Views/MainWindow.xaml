<Window x:Class="PSText.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="clr-namespace:PSText.Infrastructure.Converters"
        xmlns:behaviors="clr-namespace:PSText.Infrastructure.Behaviors"
        xmlns:batch="clr-namespace:PSText.Services.Batch"
        xmlns:filters="clr-namespace:PSText.Services.Filters"
        Title="{Binding WindowTitle}"
        Icon="pack://application:,,,/PS-text;component/Resources/PS-text.ico"
        Width="1180"
        Height="760"
        MinWidth="720"
        MinHeight="480"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True"
        Loaded="OnWindowLoaded"
        Background="{DynamicResource CanvasBackgroundBrush}"
        Foreground="{DynamicResource ChromeForegroundBrush}"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        FontSize="12"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display">

  <Window.Resources>
    <!--
      注意：不要把应用级样式放在 Window.Resources 里引用。
      经验证，窗口在解析阶段（BAML 加载）通过 StaticResource 查找“应用级 MergedDictionaries”
      里的样式并不可靠，会抛 “找不到名为 Xxx 的资源”。
      因此：通用样式与主题字典统一由 ThemeManager 在创建窗口前合并（见 Services/ThemeManager.cs）。
      这里只放窗口私有资源 + 需要类型转换器的私有样式。
    -->
    <conv:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    <conv:MultiplyConverter x:Key="Multiply" />
    <conv:CursorNameConverter x:Key="CursorName" />

    <!-- 状态栏：缩放百分比（粗体），基于应用级 StatusTextStyle -->
    <Style x:Key="ZoomTextStyle" TargetType="TextBlock" BasedOn="{StaticResource StatusTextStyle}">
      <Setter Property="FontWeight" Value="SemiBold" />
      <Setter Property="MinWidth" Value="52" />
      <Setter Property="TextAlignment" Value="Right" />
    </Style>

  </Window.Resources>

  <Grid>
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- ==================== 菜单栏 ==================== -->
    <Menu Grid.Row="0"
          Background="{DynamicResource ChromeBackgroundBrush}"
          Foreground="{DynamicResource ChromeForegroundBrush}">
      <MenuItem Header="{DynamicResource Menu_File}">
        <MenuItem Header="{DynamicResource Menu_Open}" InputGestureText="Ctrl+O" Command="{Binding OpenCommand}" />
        <MenuItem Header="{DynamicResource Menu_CloseTab}" InputGestureText="Ctrl+W"
                  Command="{Binding CloseCurrentTabCommand}" />
        <MenuItem Header="{DynamicResource Menu_Recent}">
          <MenuItem ItemsSource="{Binding RecentFiles}"
                    IsEnabled="{Binding HasRecentFiles}">
            <MenuItem.ItemContainerStyle>
              <Style TargetType="MenuItem">
                <Setter Property="Header" Value="{Binding DisplayName}" />
                <Setter Property="ToolTip" Value="{Binding FilePath}" />
                <!-- 每项自带命令，避免依赖祖先 DataContext 的绑定路径 -->
                <Setter Property="Command" Value="{Binding OpenCommand}" />
              </Style>
            </MenuItem.ItemContainerStyle>
          </MenuItem>
          <Separator />
          <MenuItem Header="{DynamicResource Menu_ClearRecent}" Command="{Binding ClearRecentFilesCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{DynamicResource Menu_Save}" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
        <MenuItem Header="{DynamicResource Menu_SaveAs}" InputGestureText="Ctrl+Shift+S" Command="{Binding SaveAsCommand}" />
        <Separator />
        <MenuItem Header="{DynamicResource Menu_Print}" InputGestureText="Ctrl+P" Command="{Binding PrintPreviewCommand}" />
        <MenuItem Header="{DynamicResource Menu_PrintDirect}" Command="{Binding PrintCommand}" />
        <Separator />
        <MenuItem Header="{DynamicResource Menu_Exit}" InputGestureText="Alt+F4" Click="OnExitClick" />
      </MenuItem>

      <MenuItem Header="{DynamicResource Menu_Edit}">
        <MenuItem Header="{DynamicResource Menu_Undo}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
        <MenuItem Header="{DynamicResource Menu_Redo}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
        <Separator />
        <MenuItem Header="{DynamicResource Menu_ResetAdjustments}" Command="{Binding ResetAdjustmentsCommand}" />
      </MenuItem>

      <MenuItem Header="{DynamicResource Menu_View}">
        <MenuItem Header="{DynamicResource Menu_FitToWindow}" InputGestureText="Ctrl+0" Command="{Binding FitToWindowCommand}" />
        <MenuItem Header="{DynamicResource Menu_ActualSize}" InputGestureText="Ctrl+1" Command="{Binding ActualSizeCommand}" />
        <Separator />
        <MenuItem Header="{DynamicResource Menu_ZoomIn}" InputGestureText="Ctrl++" Command="{Binding ZoomInCommand}" />
        <MenuItem Header="{DynamicResource Menu_ZoomOut}" InputGestureText="Ctrl+-" Command="{Binding ZoomOutCommand}" />
        <Separator />
        <MenuItem Header="{DynamicResource Menu_HandTool}" InputGestureText="{DynamicResource Menu_Space}" Command="{Binding ToggleHandToolCommand}" />
        <Separator />
        <!-- i18n-exempt:start （语言选择项刻意不翻译：语言名要用它自己的文字显示，
             否则英文用户会在一个全中文的菜单里找 English） -->
        <MenuItem Header="{DynamicResource Menu_Language}">
          <MenuItem Header="中文（简体）" IsCheckable="True"
                    IsChecked="{Binding IsLanguageChinese, Mode=TwoWay}" />
          <MenuItem Header="English" IsCheckable="True"
                    IsChecked="{Binding IsLanguageEnglish, Mode=TwoWay}" />
        </MenuItem>
        <!-- i18n-exempt:end -->
        <Separator />

        <MenuItem Header="{DynamicResource Menu_Theme}">
          <MenuItem Header="{DynamicResource Menu_ThemeFollowSystem}" IsCheckable="True"
                    IsChecked="{Binding IsSystemTheme, Mode=OneWay}"
                    Command="{Binding FollowSystemThemeCommand}" />
          <MenuItem Header="{DynamicResource Menu_ThemeLight}" IsCheckable="True"
                    IsChecked="{Binding IsLightTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="1" />
          <MenuItem Header="{DynamicResource Menu_ThemeDark}" IsCheckable="True"
                    IsChecked="{Binding IsDarkTheme, Mode=OneWay}"
                    Command="{Binding SetThemeCommand}" CommandParameter="2" />
          <Separator />
          <MenuItem Header="{DynamicResource Menu_ToggleTheme}" InputGestureText="Ctrl+T"
                    Command="{Binding ToggleThemeCommand}" />
        </MenuItem>
      </MenuItem>

      <MenuItem Header="{DynamicResource Menu_Tools}">
        <MenuItem Header="{DynamicResource Menu_FileAssociation}">
          <MenuItem Header="{DynamicResource Menu_AssocRegister}"
                    Command="{Binding RegisterFileAssociationCommand}" />
          <MenuItem Header="{DynamicResource Menu_AssocUnregister}"
                    Command="{Binding UnregisterFileAssociationCommand}" />
          <Separator />
          <MenuItem Header="{DynamicResource Menu_AssocStatus}"
                    Command="{Binding ShowFileAssociationStatusCommand}" />
          <MenuItem Header="{DynamicResource Menu_OpenDefaultApps}"
                    Command="{Binding OpenDefaultProgramsCommand}" />
        </MenuItem>
        <Separator />
        <MenuItem Header="{DynamicResource Menu_RuntimeInfo}" Command="{Binding ShowRuntimeInfoCommand}" />
        <MenuItem Header="{DynamicResource Menu_OpenLogFolder}" Command="{Binding OpenLogFolderCommand}" />
      </MenuItem>

      <MenuItem Header="{DynamicResource Menu_Help}">
        <MenuItem Header="{DynamicResource Menu_About}" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- ==================== 工具栏 ==================== -->
    <Border Grid.Row="1"
            Background="{DynamicResource ChromeBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False" Margin="6,5">

        <!-- 左侧：文件操作 -->
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
          <Button Content="{DynamicResource Tip_Open}"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Command="{Binding OpenCommand}" />
          <Button Content="{DynamicResource Tip_Save}"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Command="{Binding SaveCommand}" />
          <Button Content="{DynamicResource Tip_SaveAs}"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Command="{Binding SaveAsCommand}" />
          <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
          <Button Content="{DynamicResource Tip_Undo}"
                  Style="{StaticResource ToolbarButtonStyle}"
                  MinWidth="86"
                  ToolTip="{DynamicResource Tip_UndoHint}"
                  Command="{Binding UndoCommand}" />
          <Button Content="{DynamicResource Tip_Redo}"
                  Style="{StaticResource ToolbarButtonStyle}"
                  MinWidth="86"
                  ToolTip="{DynamicResource Tip_RedoHint}"
                  Command="{Binding RedoCommand}" />
          <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
          <ToggleButton Content="{DynamicResource Tip_HandTool}"
                        Style="{StaticResource ToolbarToggleButtonStyle}"
                        IsChecked="{Binding IsHandToolActive, Mode=OneWay}"
                        IsEnabled="{Binding HasDocument}" />
        </StackPanel>

        <!-- 右侧：视图缩放 -->
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
          <RadioButton Content="{DynamicResource Tip_FitToWindow}"
                       Style="{StaticResource ModeRadioStyle}"
                       IsChecked="{Binding IsFitToWindow, Mode=OneWay}"
                       Command="{Binding FitToWindowCommand}" />
          <RadioButton Content="{DynamicResource Tip_ActualSize}"
                       Style="{StaticResource ModeRadioStyle}"
                       IsChecked="{Binding IsActualSize, Mode=OneWay}"
                       Command="{Binding ActualSizeCommand}" />
          <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" />
          <Button Content="－"
                  Style="{StaticResource ToolbarButtonStyle}"
                  MinWidth="34"
                  ToolTip="{DynamicResource Tip_ZoomOut}"
                  Command="{Binding ZoomOutCommand}" />
          <Button Content="＋"
                  Style="{StaticResource ToolbarButtonStyle}"
                  MinWidth="34"
                  ToolTip="{DynamicResource Tip_ZoomIn}"
                  Command="{Binding ZoomInCommand}" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- ==================== 文档标签栏 ====================
         标签栏放在**独立的整行**里（而不是挤进中间的某一列），这样它横跨整个窗口宽度，
         不会因为右侧编辑面板占了 296px 而变得只剩一小截。
         没有打开的文档时整条隐藏；打开后即使只有一个标签也显示 ——
         让用户始终看得见"当前在哪一份文档上"。 -->
    <Border Grid.Row="2"
            Background="{DynamicResource ChromeBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,0,0,1"
            Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
      <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled"
                    Padding="4,3">
        <ItemsControl ItemsSource="{Binding Sessions}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate>
              <Border Margin="1,0" CornerRadius="3">
                <StackPanel Orientation="Horizontal">
                  <Button Content="{Binding TabTitle}"
                          ToolTip="{Binding TabToolTip}"
                          MinWidth="0" Padding="11,4" Margin="0" Cursor="Hand"
                          Command="{Binding DataContext.ActivateTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="TabRoot"
                                      Background="{TemplateBinding Background}"
                                      CornerRadius="3"
                                      SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="TabRoot" Property="Background"
                                          Value="{DynamicResource PrimaryHoverBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                        <Style.Triggers>
                          <!-- 当前标签：加粗 + 高亮前景 + 选中底色，三重提示 -->
                          <DataTrigger Binding="{Binding IsActiveTab}" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                            <Setter Property="Background" Value="{DynamicResource PrimarySelectedBrush}" />
                          </DataTrigger>
                        </Style.Triggers>
                      </Style>
                    </Button.Style>
                  </Button>

                  <Button Content="✕"
                          ToolTip="{DynamicResource Tip_CloseTab}"
                          MinWidth="0" Padding="4,4" Margin="0" Cursor="Hand"
                          FontSize="10"
                          Command="{Binding DataContext.CloseTabCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                          CommandParameter="{Binding}">
                    <Button.Style>
                      <Style TargetType="Button">
                        <Setter Property="Foreground" Value="{DynamicResource SubtleForegroundBrush}" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Template">
                          <Setter.Value>
                            <ControlTemplate TargetType="Button">
                              <Border x:Name="CloseRoot"
                                      Background="{TemplateBinding Background}"
                                      CornerRadius="3"
                                      SnapsToDevicePixels="True">
                                <ContentPresenter Margin="{TemplateBinding Padding}"
                                                  HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                              </Border>
                              <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                  <Setter TargetName="CloseRoot" Property="Background"
                                          Value="{DynamicResource PrimaryPressedBrush}" />
                                  <Setter Property="Foreground" Value="{DynamicResource ChromeForegroundBrush}" />
                                </Trigger>
                              </ControlTemplate.Triggers>
                            </ControlTemplate>
                          </Setter.Value>
                        </Setter>
                      </Style>
                    </Button.Style>
                  </Button>
                </StackPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- ==================== 画布 + 调整面板 ==================== -->
    <Grid Grid.Row="3">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*" MinWidth="240" />
        <ColumnDefinition Width="Auto" />
        <ColumnDefinition x:Name="EditorPanelColumn" Width="296" MinWidth="220" />
      </Grid.ColumnDefinitions>

      <!-- 左侧：画布 -->
      <Grid Grid.Column="0" Background="{DynamicResource CanvasBackgroundBrush}" ClipToBounds="True">

      <!-- 有图片时：可缩放 / 平移的画布 -->
      <Grid Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}}">
        <!-- 棋盘格底：透明图片也能看清边界（色值随主题令牌变化） -->
        <Rectangle Fill="{DynamicResource CheckerboardBrush}" Opacity="0.9" />

        <ScrollViewer x:Name="CanvasScrollViewer"
                      Background="Transparent"
                      HorizontalScrollBarVisibility="Auto"
                      VerticalScrollBarVisibility="Auto"
                      Focusable="True"
                      CanContentScroll="False"
                      behaviors:CanvasInteraction.Zoom="{Binding ZoomFactor, Mode=TwoWay}"
                      behaviors:CanvasInteraction.HandTool="{Binding IsHandToolActive, Mode=OneWay}"
                      Loaded="OnCanvasScrollViewerLoaded"
                      SizeChanged="OnCanvasSizeChanged">

          <!-- 容器尺寸 = 图片像素 × 缩放，因此 ScrollViewer 的滚动范围即为真实内容范围 -->
          <Grid x:Name="CanvasContainer"
                HorizontalAlignment="Center"
                VerticalAlignment="Center">
            <Grid.Width>
              <MultiBinding Converter="{StaticResource Multiply}">
                <Binding Path="ImagePixelWidth" />
                <Binding Path="ZoomFactor" />
              </MultiBinding>
            </Grid.Width>
            <Grid.Height>
              <MultiBinding Converter="{StaticResource Multiply}">
                <Binding Path="ImagePixelHeight" />
                <Binding Path="ZoomFactor" />
              </MultiBinding>
            </Grid.Height>

            <!-- 以中心为原点缩放，保证放大 / 缩小时画面不跑偏 -->
            <Image x:Name="CanvasImage"
                   Source="{Binding CurrentBitmap}"
                   Stretch="None"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   RenderOptions.BitmapScalingMode="HighQuality"
                   SnapsToDevicePixels="True">
              <Image.RenderTransform>
                <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" CenterX="0" CenterY="0" />
              </Image.RenderTransform>
            </Image>

            <!-- ==================== 裁剪遮罩层 ====================
                 尺寸与图像 1:1，整体随缩放比例放大，因此内部坐标即图像像素坐标，
                 鼠标位置无需额外换算。 -->
            <Canvas x:Name="CropOverlay"
                    Width="{Binding ImagePixelWidth}"
                    Height="{Binding ImagePixelHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    MouseLeftButtonDown="OnCropMouseDown"
                    MouseMove="OnCropMouseMove"
                    MouseLeftButtonUp="OnCropMouseUp"
                    Visibility="{Binding IsCropping, Converter={StaticResource BoolToVisibility}}">
              <Canvas.RenderTransform>
                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"
                                CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>

              <!-- 遮罩：整块半透明黑，用 Exclude 挖空裁剪区域 -->
              <Path Fill="{DynamicResource CropMaskBrush}" IsHitTestVisible="False">
                <Path.Data>
                  <CombinedGeometry GeometryCombineMode="Exclude">
                    <CombinedGeometry.Geometry1>
                      <RectangleGeometry Rect="0,0,100000,100000" />
                    </CombinedGeometry.Geometry1>
                    <CombinedGeometry.Geometry2>
                      <RectangleGeometry Rect="{Binding CropRect, Mode=OneWay}" />
                    </CombinedGeometry.Geometry2>
                  </CombinedGeometry>
                </Path.Data>
              </Path>

              <!-- 裁剪框边框 -->
              <Rectangle Canvas.Left="{Binding CropX}" Canvas.Top="{Binding CropY}"
                         Width="{Binding CropWidth}" Height="{Binding CropHeight}"
                         Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                         IsHitTestVisible="False" />

              <!-- 三分线辅助（需求 P1-7） -->
              <Line Canvas.Top="{Binding CropY}" X1="{Binding CropOneThirdX1}" Y1="0"
                    X2="{Binding CropOneThirdX1}" Y2="{Binding CropHeight}"
                    Stroke="{DynamicResource GuideBrush}" StrokeThickness="1" IsHitTestVisible="False" />
              <Line Canvas.Top="{Binding CropY}" X1="{Binding CropTwoThirdX1}" Y1="0"
                    X2="{Binding CropTwoThirdX1}" Y2="{Binding CropHeight}"
                    Stroke="{DynamicResource GuideBrush}" StrokeThickness="1" IsHitTestVisible="False" />
              <Line Canvas.Left="{Binding CropX}" X1="0" Y1="{Binding CropOneThirdY1}"
                    X2="{Binding CropWidth}" Y2="{Binding CropOneThirdY1}"
                    Stroke="{DynamicResource GuideBrush}" StrokeThickness="1" IsHitTestVisible="False" />
              <Line Canvas.Left="{Binding CropX}" X1="0" Y1="{Binding CropTwoThirdY1}"
                    X2="{Binding CropWidth}" Y2="{Binding CropTwoThirdY1}"
                    Stroke="{DynamicResource GuideBrush}" StrokeThickness="1" IsHitTestVisible="False" />
            </Canvas>

            <!-- ==================== 修补标记层 ====================
                 与裁剪层同理：尺寸与图像 1:1，整体随缩放放大，因此内部坐标即图像像素坐标。 -->
            <Canvas x:Name="RetouchOverlay"
                    Width="{Binding ImagePixelWidth}"
                    Height="{Binding ImagePixelHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Cursor="Cross"
                    MouseLeftButtonDown="OnRetouchMouseDown"
                    MouseMove="OnRetouchMouseMove"
                    MouseLeftButtonUp="OnRetouchMouseUp"
                    MouseLeave="OnRetouchMouseLeave"
                    Visibility="{Binding IsRetouchMode, Converter={StaticResource BoolToVisibility}}">
              <Canvas.RenderTransform>
                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"
                                CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>

              <!-- 已提交的标记（可连续框选，逐个叠加显示） -->
              <ItemsControl ItemsSource="{Binding RetouchRects}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="ContentPresenter">
                    <Setter Property="Canvas.Left" Value="{Binding X}" />
                    <Setter Property="Canvas.Top" Value="{Binding Y}" />
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Rectangle Width="{Binding Width}" Height="{Binding Height}"
                               Fill="{DynamicResource RetouchMaskFillBrush}"
                               Stroke="{DynamicResource RetouchMaskStrokeBrush}"
                               StrokeThickness="1" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 正在拖拽的矩形（实时预览） -->
              <Rectangle Canvas.Left="{Binding PendingRect.X}" Canvas.Top="{Binding PendingRect.Y}"
                         Width="{Binding PendingRect.Width}" Height="{Binding PendingRect.Height}"
                         Fill="{DynamicResource RetouchMaskFillBrush}"
                         Stroke="{DynamicResource RetouchMaskStrokeBrush}"
                         StrokeThickness="1"
                         IsHitTestVisible="False"
                         Visibility="{Binding HasPendingRect, Converter={StaticResource BoolToVisibility}}" />

              <!-- 笔迹预览：用"笔刷粗细的折线"描边，圆头圆角 —— 画出来就是实际涂抹范围，
                   和滤镜里按"像素到折线距离"算覆盖率的几何完全一致。 -->
              <Polyline Points="{Binding BrushTrailPoints}"
                        Stroke="{DynamicResource RetouchMaskStrokeBrush}"
                        StrokeThickness="{Binding BrushDiameter}"
                        StrokeLineJoin="Round"
                        StrokeStartLineCap="Round"
                        StrokeEndLineCap="Round"
                        Opacity="0.35"
                        IsHitTestVisible="False"
                        Visibility="{Binding HasStrokeTrail, Converter={StaticResource BoolToVisibility}}" />

              <!-- 仿制图章的取源点标记（用 RenderTransform 把圆心对到源点坐标上） -->
              <Ellipse Canvas.Left="{Binding CloneStampSourceLeft}" Canvas.Top="{Binding CloneStampSourceTop}"
                       Width="14" Height="14" StrokeThickness="2"
                       Stroke="{DynamicResource CloneStampSourceBrush}"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsCloneStampTool, Converter={StaticResource BoolToVisibility}}">
                <Ellipse.RenderTransform>
                  <TranslateTransform X="-7" Y="-7" />
                </Ellipse.RenderTransform>
              </Ellipse>

              <!-- 笔刷光标（跟随鼠标，只在仿制图章下显示） -->
              <Ellipse Canvas.Left="{Binding BrushCursorLeft}" Canvas.Top="{Binding BrushCursorTop}"
                       Width="{Binding BrushDiameter}" Height="{Binding BrushDiameter}"
                       StrokeThickness="1"
                       Stroke="{DynamicResource AccentBrush}"
                       IsHitTestVisible="False"
                       Visibility="{Binding IsBrushCursorVisible, Converter={StaticResource BoolToVisibility}}" />
            </Canvas>

            <!-- ==================== 标注叠加层 ====================
                 标注是**对象**而不是画进像素的东西，所以平时就画在这一层上：
                 选中改参数时只需重绘这一个对象，底图完全不用动。
                 几何来自 AnnotationVisualBuilder —— 与"合并到画面"用的是同一份，保证所见即所得。 -->
            <Canvas x:Name="AnnotationOverlay"
                    Width="{Binding ImagePixelWidth}"
                    Height="{Binding ImagePixelHeight}"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    Cursor="{Binding AnnotationCursorName, Converter={StaticResource CursorName}}"
                    MouseLeftButtonDown="OnAnnotationMouseDown"
                    MouseMove="OnAnnotationMouseMove"
                    MouseLeftButtonUp="OnAnnotationMouseUp"
                    Visibility="{Binding IsAnnotationMode, Converter={StaticResource BoolToVisibility}}">
              <Canvas.RenderTransform>
                <ScaleTransform ScaleX="{Binding ZoomFactor}" ScaleY="{Binding ZoomFactor}"
                                CenterX="0" CenterY="0" />
              </Canvas.RenderTransform>

              <ItemsControl ItemsSource="{Binding Annotations}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Canvas>
                      <Path Data="{Binding Geometry}"
                            Fill="{Binding FillBrush}"
                            Stroke="{Binding StrokeBrush}"
                            StrokeThickness="{Binding StrokeThickness}" />
                      <Path Data="{Binding LabelGeometry}" Fill="{Binding LabelBrush}" />
                    </Canvas>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 缩放手柄：选中标注后出现。
                   坐标是图像像素，但尺寸/描边都按「屏幕像素 ÷ 缩放」折算过，
                   所以放大到 800% 或缩到 10%，手柄看起来都一样大、一样好点中。 -->
              <ItemsControl ItemsSource="{Binding AnnotationHandles}" IsHitTestVisible="False">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <Canvas />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Canvas>
                      <Rectangle Canvas.Left="{Binding Left}"
                                 Canvas.Top="{Binding Top}"
                                 Width="{Binding Size}"
                                 Height="{Binding Size}"
                                 Fill="White"
                                 Stroke="#FF1E6FD9"
                                 StrokeThickness="{Binding StrokeThickness}"
                                 RadiusX="1.5" RadiusY="1.5" />
                    </Canvas>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>

              <!-- 选中框 -->
              <Rectangle Canvas.Left="{Binding AnnotationSelectionLeft}"
                         Canvas.Top="{Binding AnnotationSelectionTop}"
                         Width="{Binding AnnotationSelectionWidth}"
                         Height="{Binding AnnotationSelectionHeight}"
                         Stroke="{DynamicResource AccentBrush}"
                         StrokeThickness="1"
                         StrokeDashArray="4 3"
                         IsHitTestVisible="False"
                         Visibility="{Binding HasSelectedAnnotation, Converter={StaticResource BoolToVisibility}}" />
            </Canvas>
          </Grid>
        </ScrollViewer>
      </Grid>

      <!-- 无图片时：空状态提示 + 拖放目标 -->
      <Border x:Name="EmptyHint"
              Background="Transparent"
              Visibility="{Binding HasDocument, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <TextBlock Text="{DynamicResource Empty_DropHint}"
                     FontSize="18"
                     Foreground="{DynamicResource SubtleForegroundBrush}"
                     HorizontalAlignment="Center" />
          <TextBlock Text="{DynamicResource Empty_SupportedFormats}"
                     FontSize="13"
                     Margin="0,10,0,0"
                     Foreground="{DynamicResource SubtleForegroundBrush}"
                     HorizontalAlignment="Center" />
          <Button Content="{DynamicResource Empty_OpenButton}"
                  Style="{StaticResource ToolbarButtonStyle}"
                  Margin="0,22,0,0"
                  Padding="18,8"
                  HorizontalAlignment="Center"
                  Command="{Binding OpenCommand}" />
        </StackPanel>
      </Border>

      <!-- Loading 遮罩：耗时操作时显示，保证 UI 不阻塞 -->
      <Border Background="{DynamicResource OverlayBrush}"
              Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
          <ProgressBar IsIndeterminate="True" Width="220" Height="6" />
          <TextBlock Text="{DynamicResource Empty_Busy}"
                     Margin="0,14,0,0"
                     Foreground="White"
                     HorizontalAlignment="Center" />
        </StackPanel>
      </Border>
      </Grid>

      <!-- 分隔条：可拖动调整面板宽度 -->
      <GridSplitter Grid.Column="1"
                    Width="4"
                    HorizontalAlignment="Stretch"
                    VerticalAlignment="Stretch"
                    Background="{DynamicResource BorderBrush}"
                    ResizeBehavior="PreviousAndNext" />

      <!-- 右侧：基础调整面板 -->
      <!-- 右侧：编辑面板（分页） -->
      <Border Grid.Column="2"
              Background="{DynamicResource ChromeBackgroundBrush}"
              BorderBrush="{DynamicResource BorderBrush}"
              BorderThickness="1,0,0,0">
        <TabControl Background="Transparent"
                    BorderThickness="0"
                    Foreground="{DynamicResource ChromeForegroundBrush}"
                    FontSize="12">

          <!-- ==================== 调整 ==================== -->
          <TabItem Header="{DynamicResource Adjust_Header}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">
                <TextBlock Text="{DynamicResource Adjust_Hint}"
                           FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Brightness}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="34" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding Brightness, StringFormat={}{0:0}}" />
                </DockPanel>
                <Slider Minimum="-100" Maximum="100" TickFrequency="10" SmallChange="1" LargeChange="10"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding Brightness, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=40}" />

                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Contrast}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="34" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding Contrast, StringFormat={}{0:0}}" />
                </DockPanel>
                <Slider Minimum="-100" Maximum="100" TickFrequency="10" SmallChange="1" LargeChange="10"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding Contrast, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=40}" />

                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Saturation}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="34" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding Saturation, StringFormat={}{0:0}}" />
                </DockPanel>
                <Slider Minimum="-100" Maximum="100" TickFrequency="10" SmallChange="1" LargeChange="10"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding Saturation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=40}" />

                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Temperature}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="34" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding Temperature, StringFormat={}{0:0}}" />
                </DockPanel>
                <Slider Minimum="-100" Maximum="100" TickFrequency="10" SmallChange="1" LargeChange="10"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding Temperature, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, Delay=40}" />
                <DockPanel Margin="0,2,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Cool}" Style="{StaticResource StatusLabelStyle}" Margin="0" FontSize="10" />
                  <TextBlock DockPanel.Dock="Right" Text="{DynamicResource Adjust_Warm}" Style="{StaticResource StatusLabelStyle}" Margin="0" FontSize="10" />
                </DockPanel>

                <TextBlock Text="{Binding AdjustmentsText}" Margin="0,14,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Button Content="{DynamicResource Adjust_Reset}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding ResetAdjustmentsCommand}" />

                <Rectangle Height="1" Margin="0,16" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Adjust_History}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Text="{Binding HistoryText}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Adjust_HistoryHint}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="{DynamicResource Adjust_Undo}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding UndoCommand}" />
                  <Button Content="{DynamicResource Adjust_Redo}" Style="{StaticResource ToolbarButtonStyle}" Command="{Binding RedoCommand}" />
                </StackPanel>

                <TextBlock Text="{DynamicResource Adjust_Applying}" Margin="0,12,0,0" FontSize="11"
                           Foreground="{DynamicResource AccentBrush}"
                           Visibility="{Binding IsRendering, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ==================== 滤镜 ==================== -->
          <TabItem Header="{DynamicResource Filter_Header}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">

                <TextBlock Text="{DynamicResource Filter_Quick}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="{DynamicResource Filter_Invert}" MinWidth="64" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding InvertCommand}" />
                  <Button Content="{DynamicResource Filter_Grayscale}" MinWidth="64" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding GrayscaleCommand}" />
                </StackPanel>

                <DockPanel Margin="0,14,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Filter_Threshold}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="34" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding Threshold}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="255" TickFrequency="16" SmallChange="1" LargeChange="16"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding Threshold, Mode=TwoWay}" />
                <Button Content="{DynamicResource Filter_ApplyThreshold}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding ThresholdCommand}" />

                <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Filter_BlurSharpen}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />

                <DockPanel Margin="0,8,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Filter_BlurRadius}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="40" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding BlurRadius, StringFormat={}{0:0} px}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="100" TickFrequency="5" SmallChange="0.5" LargeChange="5"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding BlurRadius, Mode=TwoWay}" />
                <Button Content="{DynamicResource Filter_GaussianBlur}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding BlurCommand}" />

                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Filter_SharpenAmount}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="40" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding SharpenAmount, StringFormat={}{0:0}%}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="400" TickFrequency="20" SmallChange="5" LargeChange="20"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding SharpenAmount, Mode=TwoWay}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Filter_SharpenRadius}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="40" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding SharpenRadius, StringFormat={}{0:0.#} px}" />
                </DockPanel>
                <Slider Minimum="0.5" Maximum="20" TickFrequency="0.5" SmallChange="0.5" LargeChange="1"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding SharpenRadius, Mode=TwoWay}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Filter_SharpenThreshold}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="34" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding SharpenThreshold}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="64" TickFrequency="2" SmallChange="1" LargeChange="4"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding SharpenThreshold, Mode=TwoWay}" />
                <Button Content="{DynamicResource Filter_UnsharpMask}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,6,0,0" HorizontalAlignment="Left"
                        Command="{Binding SharpenCommand}" />

                <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Geometry_RotateFlip}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <WrapPanel Margin="0,8,0,0">
                  <Button Content="{DynamicResource Geometry_RotateCcw}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding RotateCounterClockwiseCommand}" />
                  <Button Content="{DynamicResource Geometry_RotateCw}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding RotateClockwiseCommand}" />
                  <Button Content="180°" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding Rotate180Command}" />
                  <Button Content="{DynamicResource Geometry_FlipHorizontal}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding FlipHorizontalCommand}" />
                  <Button Content="{DynamicResource Geometry_FlipVertical}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding FlipVerticalCommand}" />
                </WrapPanel>

                <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Crop_Header}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Text="{DynamicResource Crop_Hint}"
                           Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="{DynamicResource Crop_Begin}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding BeginCropCommand}" />
                  <Button Content="{DynamicResource Crop_Apply}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ApplyCropCommand}" />
                  <Button Content="{DynamicResource Common_Cancel}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding CancelCropCommand}" />
                </StackPanel>
                <TextBlock Text="{Binding CropInfoText}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ==================== 边框与文字 ==================== -->
          <TabItem Header="{DynamicResource BorderText_Header}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">

                <TextBlock Text="{DynamicResource Border_Header}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />

                <TextBlock Text="{DynamicResource Batch_Style}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox SelectedIndex="{Binding BorderStyleIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}">
                  <ComboBoxItem Content="{DynamicResource Border_Plain}" />
                  <ComboBoxItem Content="{DynamicResource Border_InnerFrame}" />
                  <ComboBoxItem Content="{DynamicResource Border_SoftShadow}" />
                </ComboBox>

                <DockPanel Margin="0,12,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Border_Width}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="40" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding BorderWidth, StringFormat={}{0} px}" />
                </DockPanel>
                <Slider Minimum="1" Maximum="200" TickFrequency="4" SmallChange="1" LargeChange="10"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding BorderWidth, Mode=TwoWay}" />

                <TextBlock Text="{DynamicResource Annotation_Color}" Margin="0,12,0,0" Style="{StaticResource StatusLabelStyle}" />
                <WrapPanel Margin="0,4,0,0">
                  <Button Content="{DynamicResource Common_White}" Style="{StaticResource ToolbarButtonStyle}" Click="OnBorderColorWhite" />
                  <Button Content="{DynamicResource Common_Black}" Style="{StaticResource ToolbarButtonStyle}" Click="OnBorderColorBlack" />
                  <Button Content="{DynamicResource Border_LightGray}" Style="{StaticResource ToolbarButtonStyle}" Click="OnBorderColorGray" />
                  <Button Content="{DynamicResource Border_Beige}" Style="{StaticResource ToolbarButtonStyle}" Click="OnBorderColorCream" />
                </WrapPanel>
                <TextBlock Text="{DynamicResource Border_CurrentColor}" Margin="0,8,0,0" FontSize="11"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <Rectangle Height="20" Margin="0,4,0,0" RadiusX="3" RadiusY="3"
                           Fill="{Binding BorderColorBrush}"
                           Stroke="{DynamicResource BorderBrush}" />

                <Button Content="{DynamicResource Border_Apply}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding ApplyBorderCommand}" />

                <Rectangle Height="1" Margin="0,16" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Text_Content}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />

                <TextBlock Text="{DynamicResource Text_Header}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                <TextBox Text="{Binding TextContent, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding HasDocument}" />

                <TextBlock Text="{DynamicResource Text_Font}" Margin="0,10,0,0" Style="{StaticResource StatusLabelStyle}" />
                <TextBox Text="{Binding TextFontFamily, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding HasDocument}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Text_Size}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="40" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding TextFontSize, StringFormat={}{0:0} px}" />
                </DockPanel>
                <Slider Minimum="8" Maximum="200" TickFrequency="4" SmallChange="1" LargeChange="8"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding TextFontSize, Mode=TwoWay}" />

                <StackPanel Visibility="{Binding IsTextTiled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                  <TextBlock Text="{DynamicResource Text_Position}" Margin="0,10,0,0" Style="{StaticResource StatusLabelStyle}" />
                  <ComboBox SelectedIndex="{Binding TextAnchorIndex, Mode=TwoWay}"
                            IsEnabled="{Binding HasDocument}">
                    <ComboBoxItem Content="{DynamicResource Anchor_TopLeft}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_TopCenter}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_TopRight}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_MiddleLeft}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_Center}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_MiddleRight}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_BottomLeft}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_BottomCenter}" />
                    <ComboBoxItem Content="{DynamicResource Anchor_BottomRight}" />
                  </ComboBox>
                </StackPanel>

                <TextBlock Text="{DynamicResource Text_Layout}" Margin="0,10,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox SelectedIndex="{Binding TextLayoutIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}">
                  <ComboBoxItem Content="{DynamicResource Text_LayoutSingle}" />
                  <ComboBoxItem Content="{DynamicResource Text_LayoutTile}" />
                </ComboBox>

                <StackPanel Visibility="{Binding IsTextTiled, Converter={StaticResource BoolToVisibility}}">
                  <Grid Margin="0,8,0,0">
                    <Grid.ColumnDefinitions>
                      <ColumnDefinition Width="*" />
                      <ColumnDefinition Width="8" />
                      <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                      <TextBlock Text="{DynamicResource Text_TileSpacingX}" Style="{StaticResource StatusLabelStyle}" />
                      <TextBox Text="{Binding TextTileSpacingX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                      <TextBlock Text="{DynamicResource Text_TileSpacingY}" Style="{StaticResource StatusLabelStyle}" />
                      <TextBox Text="{Binding TextTileSpacingY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </StackPanel>
                  </Grid>

                  <DockPanel Margin="0,8,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Text_TileAngle}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                    <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                               Style="{StaticResource StatusTextStyle}" Margin="0"
                               Text="{Binding TextTileAngle, StringFormat={}{0:0}°}" />
                  </DockPanel>
                  <Slider Minimum="-75" Maximum="75" TickFrequency="5" SmallChange="1" LargeChange="5"
                          IsEnabled="{Binding HasDocument}"
                          Value="{Binding TextTileAngle, Mode=TwoWay}" />
                </StackPanel>

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <CheckBox Content="{DynamicResource Text_Bold}" IsChecked="{Binding TextBold, Mode=TwoWay}"
                            IsEnabled="{Binding HasDocument}"
                            Foreground="{DynamicResource ChromeForegroundBrush}" />
                  <CheckBox Content="{DynamicResource Text_Italic}" Margin="12,0,0,0" IsChecked="{Binding TextItalic, Mode=TwoWay}"
                            IsEnabled="{Binding HasDocument}"
                            Foreground="{DynamicResource ChromeForegroundBrush}" />
                  <CheckBox Content="{DynamicResource Text_Shadow}" Margin="12,0,0,0" IsChecked="{Binding TextShadow, Mode=TwoWay}"
                            IsEnabled="{Binding HasDocument}"
                            Foreground="{DynamicResource ChromeForegroundBrush}" />
                </StackPanel>

                <WrapPanel Margin="0,10,0,0">
                  <Button Content="{DynamicResource Common_White}" Style="{StaticResource ToolbarButtonStyle}" Click="OnTextColorWhite" />
                  <Button Content="{DynamicResource Common_Black}" Style="{StaticResource ToolbarButtonStyle}" Click="OnTextColorBlack" />
                  <Button Content="{DynamicResource Common_Yellow}" Style="{StaticResource ToolbarButtonStyle}" Click="OnTextColorYellow" />
                  <Button Content="{DynamicResource Common_Red}" Style="{StaticResource ToolbarButtonStyle}" Click="OnTextColorRed" />
                </WrapPanel>

                <Button Content="{DynamicResource Text_Apply}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,12,0,0" HorizontalAlignment="Left"
                        Command="{Binding ApplyTextCommand}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ==================== 尺寸 ==================== -->
          <TabItem Header="{DynamicResource Resize_Size}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">

                <TextBlock Text="{DynamicResource Resize_Header}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Text="{Binding ResizeOriginalText}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <TextBlock Text="{DynamicResource Resize_Unit}" Margin="0,12,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox SelectedIndex="{Binding ResizeUnitIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}">
                  <ComboBoxItem Content="{DynamicResource Resize_UnitPixels}" />
                  <ComboBoxItem Content="{DynamicResource Resize_UnitPercent}" />
                  <ComboBoxItem Content="{DynamicResource Resize_UnitCm}" />
                </ComboBox>

                <Grid Margin="0,10,0,0">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0">
                    <TextBlock Text="{DynamicResource Resize_Width}" Style="{StaticResource StatusLabelStyle}" />
                    <TextBox Text="{Binding ResizeTargetWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasDocument}" />
                  </StackPanel>
                  <TextBlock Grid.Column="1" Text="×" Margin="8,18,8,0"
                             Foreground="{DynamicResource SubtleForegroundBrush}" />
                  <StackPanel Grid.Column="2">
                    <TextBlock Text="{DynamicResource Resize_Height}" Style="{StaticResource StatusLabelStyle}" />
                    <TextBox Text="{Binding ResizeTargetHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             IsEnabled="{Binding HasDocument}" />
                  </StackPanel>
                </Grid>

                <CheckBox Content="{DynamicResource Resize_LockAspect}" Margin="0,10,0,0"
                          IsChecked="{Binding LockAspectRatio, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}"
                          Foreground="{DynamicResource ChromeForegroundBrush}" />

                <TextBlock Text="{DynamicResource Resize_Presets}" Margin="0,10,0,0" Style="{StaticResource StatusLabelStyle}" />
                <WrapPanel Margin="0,4,0,0">
                  <Button Content="25%" MinWidth="46" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ApplyResizePresetCommand}" CommandParameter="25"
                          IsEnabled="{Binding HasDocument}" />
                  <Button Content="50%" MinWidth="46" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ApplyResizePresetCommand}" CommandParameter="50"
                          IsEnabled="{Binding HasDocument}" />
                  <Button Content="100%" MinWidth="46" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ApplyResizePresetCommand}" CommandParameter="100"
                          IsEnabled="{Binding HasDocument}" />
                  <Button Content="200%" MinWidth="46" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ApplyResizePresetCommand}" CommandParameter="200"
                          IsEnabled="{Binding HasDocument}" />
                </WrapPanel>

                <TextBlock Text="{DynamicResource Resize_Interpolation}" Margin="0,12,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox SelectedIndex="{Binding ResizeKernelIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}">
                  <ComboBoxItem Content="{DynamicResource Resize_Cubic}" />
                  <ComboBoxItem Content="{DynamicResource Resize_Bilinear}" />
                  <ComboBoxItem Content="{DynamicResource Resize_Nearest}" />
                </ComboBox>

                <TextBlock Text="{Binding ResizeResultText}" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Button Content="{DynamicResource Resize_Apply}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding ApplyResizeCommand}" />

                <Rectangle Height="1" Margin="0,16" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Rotate_Header}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Rotate_Angle}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="52" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding RotationDegrees, StringFormat={}{0:0.#}°}" />
                </DockPanel>
                <Slider Minimum="-180" Maximum="180" TickFrequency="15" SmallChange="0.5" LargeChange="5"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding RotationDegrees, Mode=TwoWay}" />

                <TextBlock Text="{DynamicResource Rotate_Fill}" Margin="0,12,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox SelectedIndex="{Binding RotationFillIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}">
                  <ComboBoxItem Content="{DynamicResource Rotate_FillTransparent}" />
                  <ComboBoxItem Content="{DynamicResource Common_White}" />
                  <ComboBoxItem Content="{DynamicResource Common_Black}" />
                  <ComboBoxItem Content="{DynamicResource Rotate_FillGray}" />
                </ComboBox>

                <CheckBox Content="{DynamicResource Rotate_CropInscribed}" Margin="0,10,0,0"
                          IsChecked="{Binding RotationCropToInscribed, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}"
                          Foreground="{DynamicResource ChromeForegroundBrush}" />

                <TextBlock Text="{Binding RotationResultText}" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Button Content="{DynamicResource Rotate_Apply}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding ApplyRotationCommand}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ==================== 修补 ==================== -->
          <TabItem Header="{DynamicResource Retouch_Header}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">

                <TextBlock Text="{DynamicResource Retouch_Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />

                <TextBlock Text="{DynamicResource Retouch_Tool}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox SelectedIndex="{Binding RetouchToolIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}">
                  <ComboBoxItem Content="{DynamicResource Retouch_Heal}" />
                  <ComboBoxItem Content="{DynamicResource Retouch_Clone}" />
                </ComboBox>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="{DynamicResource Retouch_Enter}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding BeginRetouchCommand}" />
                  <Button Content="{DynamicResource Retouch_Exit}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ExitRetouchCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding RetouchInfoText}" Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Button Content="{DynamicResource Retouch_ApplyHeal}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding ApplyInpaintCommand}" />
                <Button Content="{DynamicResource Retouch_ClearMarks}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,8,0,0" HorizontalAlignment="Left"
                        Command="{Binding ClearRetouchMaskCommand}" />

                <Rectangle Height="1" Margin="0,16" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Retouch_CloneStamp}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Retouch_BrushRadius}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding BrushRadius, StringFormat={}{0:0} px}" />
                </DockPanel>
                <Slider Minimum="4" Maximum="120" TickFrequency="8" SmallChange="1" LargeChange="8"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding BrushRadius, Mode=TwoWay}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Retouch_BrushHardness}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding BrushHardnessPercentText}" />
                </DockPanel>
                <Slider Minimum="0" Maximum="1" TickFrequency="0.1" SmallChange="0.05" LargeChange="0.1"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding BrushHardness, Mode=TwoWay}" />

                <TextBlock Text="{Binding ClipCloneStampInfoText}" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <Rectangle Height="1" Margin="0,16" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Retouch_LimitsTitle}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Text="{DynamicResource Retouch_LimitText}" />
                <TextBlock Text="{DynamicResource Retouch_HowHeal}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Retouch_HowClone}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Retouch_UndoHint}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ==================== 标注 ==================== -->
          <TabItem Header="{DynamicResource Annotation_Tab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">

                <TextBlock Text="{DynamicResource Annotation_Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Text="{DynamicResource Annotation_Intro}" />

                <TextBlock Text="{DynamicResource Annotation_Type}" Margin="0,12,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox SelectedIndex="{Binding AnnotationToolIndex, Mode=TwoWay}"
                          IsEnabled="{Binding HasDocument}">
                  <ComboBoxItem Content="{DynamicResource Annotation_Arrow}" />
                  <ComboBoxItem Content="{DynamicResource Annotation_Rectangle}" />
                  <ComboBoxItem Content="{DynamicResource Annotation_Ellipse}" />
                  <ComboBoxItem Content="{DynamicResource Annotation_NumberBadge}" />
                  <ComboBoxItem Content="{DynamicResource Annotation_Highlight}" />
                  <ComboBoxItem Content="{DynamicResource Text_Content}" />
                  <ComboBoxItem Content="{DynamicResource Annotation_Mosaic}" />
                </ComboBox>

                <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                  <Button Content="{DynamicResource Annotation_Enter}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding BeginAnnotationCommand}" />
                  <Button Content="{DynamicResource Retouch_Exit}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ExitAnnotationCommand}" />
                </StackPanel>

                <TextBlock Text="{DynamicResource Annotation_Color}" Margin="0,12,0,0" Style="{StaticResource StatusLabelStyle}" />
                <WrapPanel Margin="0,4,0,0">
                  <Button Content="{DynamicResource Common_Red}" Style="{StaticResource ToolbarButtonStyle}" Click="OnAnnotationColorRed" />
                  <Button Content="{DynamicResource Common_Yellow}" Style="{StaticResource ToolbarButtonStyle}" Click="OnAnnotationColorYellow" />
                  <Button Content="{DynamicResource Common_Green}" Style="{StaticResource ToolbarButtonStyle}" Click="OnAnnotationColorGreen" />
                  <Button Content="{DynamicResource Common_Blue}" Style="{StaticResource ToolbarButtonStyle}" Click="OnAnnotationColorBlue" />
                  <Button Content="{DynamicResource Common_White}" Style="{StaticResource ToolbarButtonStyle}" Click="OnAnnotationColorWhite" />
                  <Button Content="{DynamicResource Common_Black}" Style="{StaticResource ToolbarButtonStyle}" Click="OnAnnotationColorBlack" />
                </WrapPanel>
                <Rectangle Height="20" Margin="0,6,0,0" RadiusX="3" RadiusY="3"
                           Fill="{Binding AnnotationColorBrush}"
                           Stroke="{DynamicResource BorderBrush}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Annotation_StrokeWidth}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding AnnotationStrokeWidth, StringFormat={}{0:0} px}" />
                </DockPanel>
                <Slider Minimum="1" Maximum="24" TickFrequency="2" SmallChange="1" LargeChange="2"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding AnnotationStrokeWidth, Mode=TwoWay}" />

                <DockPanel Margin="0,10,0,0" LastChildFill="False">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Annotation_FontSize}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding AnnotationFontSize, StringFormat={}{0:0} px}" />
                </DockPanel>
                <Slider Minimum="8" Maximum="120" TickFrequency="8" SmallChange="2" LargeChange="8"
                        IsEnabled="{Binding HasDocument}"
                        Value="{Binding AnnotationFontSize, Mode=TwoWay}" />

                <TextBlock Text="{DynamicResource Annotation_TextContent}" Margin="0,10,0,0" Style="{StaticResource StatusLabelStyle}" />
                <TextBox Text="{Binding AnnotationText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                         IsEnabled="{Binding HasDocument}" />

                <!-- 遮盖参数：当前工具是遮盖，或选中了一个遮盖标注时显示 -->
                <StackPanel Visibility="{Binding ShowCoverControls, Converter={StaticResource BoolToVisibility}}">
                  <TextBlock Text="{DynamicResource Annotation_CoverStyle}" Margin="0,10,0,0" Style="{StaticResource StatusLabelStyle}" />
                  <ComboBox SelectedIndex="{Binding AnnotationMosaicStyleIndex, Mode=TwoWay}">
                    <ComboBoxItem Content="{DynamicResource Annotation_CoverPixelate}" />
                    <ComboBoxItem Content="{DynamicResource Annotation_CoverBlur}" />
                  </ComboBox>

                  <DockPanel Margin="0,10,0,0" LastChildFill="False">
                    <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Annotation_CoverStrength}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                    <TextBlock DockPanel.Dock="Right" MinWidth="86" TextAlignment="Right"
                               Style="{StaticResource StatusTextStyle}" Margin="0"
                               Text="{Binding AnnotationCoverText}" />
                  </DockPanel>
                  <Slider Minimum="2" Maximum="120" TickFrequency="2" SmallChange="1" LargeChange="4"
                          IsEnabled="{Binding HasDocument}"
                          Value="{Binding AnnotationCoverSize, Mode=TwoWay}" />
                  <TextBlock Margin="0,2,0,0" FontSize="11" TextWrapping="Wrap"
                             Foreground="{DynamicResource SubtleForegroundBrush}"
                             Text="{DynamicResource Annotation_CoverHint}" />
                </StackPanel>

                <TextBlock Text="{Binding SelectedAnnotationInfoText}" Margin="0,12,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="{DynamicResource Annotation_Delete}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding DeleteSelectedAnnotationCommand}" />
                  <Button Content="{DynamicResource Annotation_ClearAll}" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ClearAnnotationsCommand}" />
                </StackPanel>

                <Button Content="{DynamicResource Annotation_Flatten}" Style="{StaticResource ToolbarButtonStyle}"
                        Margin="0,10,0,0" HorizontalAlignment="Left"
                        Command="{Binding FlattenAnnotationsCommand}" />

                <Rectangle Height="1" Margin="0,16" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Annotation_HowTo}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Text="{DynamicResource Annotation_Step1}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Annotation_Step2}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Annotation_Step3}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Annotation_Step4}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Annotation_Step5}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{DynamicResource Annotation_UndoHint}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ==================== 打印 ==================== -->
          <TabItem Header="{DynamicResource Print_Tab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">

                <TextBlock Text="{DynamicResource Print_PrintCurrent}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Text="{DynamicResource Print_DpiHint}"
                           Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="{DynamicResource Print_Preview}" MinWidth="92" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding PrintPreviewCommand}" />
                  <Button Content="{DynamicResource Print_Direct}" MinWidth="82" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding PrintCommand}" />
                </StackPanel>

                <Rectangle Height="1" Margin="0,16" Fill="{DynamicResource BorderBrush}" />

                <TextBlock Text="{DynamicResource Print_Batch}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Text="{DynamicResource Print_QueueHint}"
                           Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                  <Button Content="{DynamicResource Print_AddCurrent}" MinWidth="86" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding AddCurrentToBatchCommand}" />
                  <Button Content="{DynamicResource Batch_AddFiles}" MinWidth="86" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding AddFilesToBatchCommand}" />
                </StackPanel>

                <ListBox x:Name="BatchList"
                         Height="180"
                         Margin="0,10,0,0"
                         ItemsSource="{Binding BatchItems}"
                         DisplayMemberPath="FileName"
                         IsEnabled="{Binding IsBatchPrinting, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                  <Button Content="{DynamicResource Batch_RemoveSelected}" MinWidth="82" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding RemoveBatchItemCommand}"
                          CommandParameter="{Binding SelectedItem, ElementName=BatchList}" />
                  <Button Content="{DynamicResource Batch_Clear}" MinWidth="60" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ClearBatchCommand}" />
                  <Button Content="{DynamicResource Print_Start}" MinWidth="86" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding StartBatchPrintCommand}" />
                </StackPanel>

                <TextBlock Text="{Binding BatchProgressText}" Margin="0,10,0,0" FontSize="11"
                           TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />

                <ProgressBar Height="6" Margin="0,6,0,0"
                             IsIndeterminate="True"
                             Visibility="{Binding IsBatchPrinting, Converter={StaticResource BoolToVisibility}}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>

          <!-- ==================== 批量流水线 ==================== -->
          <TabItem Header="{DynamicResource Batch_Tab}">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
              <StackPanel Margin="14,12">

                <TextBlock Text="{DynamicResource Batch_Title}" FontSize="14" FontWeight="SemiBold"
                           Foreground="{DynamicResource ChromeForegroundBrush}" />
                <TextBlock Text="{DynamicResource Batch_Intro}"
                           Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <!-- ===== 1. 来源 ===== -->
                <TextBlock Text="{DynamicResource Batch_SourceTitle}" Margin="0,14,0,0" Style="{StaticResource StatusLabelStyle}" />

                <WrapPanel Margin="0,4,0,0">
                  <Button Content="{DynamicResource Batch_AddFiles}" MinWidth="80" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding AddBatchFilesCommand}" />
                  <Button Content="{DynamicResource Batch_AddFolder}" MinWidth="86" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding AddBatchFolderCommand}" />
                  <Button Content="{DynamicResource Batch_AddCurrent}" MinWidth="80" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding AddCurrentBatchItemCommand}" />
                </WrapPanel>

                <CheckBox Content="{DynamicResource Batch_IncludeSubfolders}" Margin="0,6,0,0"
                          IsChecked="{Binding BatchIncludeSubfolders, Mode=TwoWay}"
                          Foreground="{DynamicResource ChromeForegroundBrush}" />

                <ListBox x:Name="BatchQueueList" Height="118" Margin="0,8,0,0"
                         ItemsSource="{Binding BatchQueue}"
                         SelectedItem="{Binding SelectedBatchItem, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel>
                        <DockPanel LastChildFill="True">
                          <TextBlock x:Name="QueueItemCustomBadge" DockPanel.Dock="Right"
                                     Margin="6,0,0,0" FontSize="10" Padding="4,0"
                                     Foreground="{DynamicResource AccentBrush}"
                                     Text="{DynamicResource Batch_CustomBadge}"
                                     Visibility="{Binding HasCustomSteps, Converter={StaticResource BoolToVisibility}}" />
                          <TextBlock x:Name="QueueItemName" Text="{Binding FileName}"
                                     TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                        <TextBlock Text="{Binding Status}" FontSize="10" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubtleForegroundBrush}" />
                      </StackPanel>
                      <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding IsFailed}" Value="True">
                          <Setter TargetName="QueueItemName" Property="Foreground" Value="#E03A3A" />
                        </DataTrigger>
                      </DataTemplate.Triggers>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Margin="0,6,0,0">
                  <Button Content="{DynamicResource Batch_RemoveSelected}" MinWidth="74" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding RemoveBatchQueueItemCommand}"
                          CommandParameter="{Binding SelectedItem, ElementName=BatchQueueList}" />
                  <Button Content="{DynamicResource Batch_ClearQueue}" MinWidth="74" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ClearBatchQueueCommand}" />
                </WrapPanel>

                <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource BorderBrush}" />

                <!-- ===== 2. 流水线步骤 ===== -->
                <TextBlock Text="{DynamicResource Batch_PipelineTitle}" Style="{StaticResource StatusLabelStyle}" />
                <TextBlock Text="{DynamicResource Batch_OrderHint}"
                           Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />

                <!-- 每张图独立参数：编辑对象提示 + 三个切换按钮 -->
                <TextBlock Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding BatchEditorTargetText}" />
                <WrapPanel Margin="0,4,0,0">
                  <Button Content="{DynamicResource Batch_CustomizeItem}" MinWidth="0"
                          Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding CustomizeBatchItemParamsCommand}" />
                  <Button Content="{DynamicResource Batch_ResetItemScope}" MinWidth="0"
                          Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ResetBatchItemParamsCommand}" />
                  <Button Content="{DynamicResource Batch_PushToShared}" MinWidth="0"
                          Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding PushBatchItemParamsToSharedCommand}" />
                </WrapPanel>
                <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}"
                           Text="{DynamicResource Batch_PerImageHint}" />

                <DockPanel Margin="0,6,0,0" LastChildFill="True">
                  <Button DockPanel.Dock="Right" Content="{DynamicResource Batch_Add}" MinWidth="54" Margin="6,0,0,0"
                          Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding AddBatchStepCommand}" />
                  <ComboBox ItemsSource="{Binding BatchStepKindOptions}"
                            DisplayMemberPath="Name"
                            SelectedValuePath="Kind"
                            SelectedValue="{Binding BatchNewStepKind, Mode=TwoWay}" />
                </DockPanel>

                <ListBox x:Name="BatchStepList" Height="126" Margin="0,8,0,0"
                         ItemsSource="{Binding BatchSteps}"
                         SelectedItem="{Binding SelectedBatchStep, Mode=TwoWay}">
                  <ListBox.ItemTemplate>
                    <DataTemplate>
                      <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding OrderText}" MinWidth="18" FontWeight="SemiBold"
                                   Foreground="{DynamicResource AccentBrush}" />
                        <StackPanel>
                          <TextBlock Text="{Binding DisplayName}" />
                          <TextBlock Text="{Binding Summary}" FontSize="10" TextWrapping="Wrap"
                                     Foreground="{DynamicResource SubtleForegroundBrush}" />
                        </StackPanel>
                      </StackPanel>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>

                <WrapPanel Margin="0,6,0,0">
                  <Button Content="{DynamicResource Batch_MoveUp}" MinWidth="52" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding MoveBatchStepUpCommand}" />
                  <Button Content="{DynamicResource Batch_MoveDown}" MinWidth="52" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding MoveBatchStepDownCommand}" />
                  <Button Content="{DynamicResource Batch_Remove}" MinWidth="52" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding RemoveBatchStepCommand}" />
                  <Button Content="{DynamicResource Batch_Clear}" MinWidth="52" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding ClearBatchStepsCommand}" />
                </WrapPanel>

                <TextBlock Text="{Binding BatchStepChainText}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />

                <!-- 步骤参数（按选中步骤类型切换） -->
                <Border Margin="0,8,0,0" Padding="9" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}">
                  <StackPanel>

                    <TextBlock Text="{DynamicResource Batch_SelectStepHint}"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               Visibility="{Binding HasSelectedBatchStep, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />

                    <!-- 尺寸缩放 -->
                    <StackPanel Visibility="{Binding IsResizeStepSelected, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{DynamicResource Batch_ConstraintMode}" Style="{StaticResource StatusLabelStyle}" />
                      <ComboBox SelectedValue="{Binding BatchResizeMode, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Batch_ConstrainLongEdge}" Tag="{x:Static batch:BatchResizeMode.LongEdge}" />
                        <ComboBoxItem Content="{DynamicResource Batch_ConstrainWidth}" Tag="{x:Static batch:BatchResizeMode.FitWidth}" />
                        <ComboBoxItem Content="{DynamicResource Batch_ConstrainHeight}" Tag="{x:Static batch:BatchResizeMode.FitHeight}" />
                        <ComboBoxItem Content="{DynamicResource Batch_ExactSize}" Tag="{x:Static batch:BatchResizeMode.Exact}" />
                        <ComboBoxItem Content="{DynamicResource Batch_Percent}" Tag="{x:Static batch:BatchResizeMode.Percent}" />
                      </ComboBox>

                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{DynamicResource Batch_ConstraintOptions}" Style="{StaticResource StatusLabelStyle}" />
                          <TextBox Text="{Binding BatchResizeValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{DynamicResource Batch_ExactSizeLabel}" Style="{StaticResource StatusLabelStyle}" />
                          <StackPanel Orientation="Horizontal">
                            <TextBox Width="58"
                                     Text="{Binding BatchResizeWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock Text="×" Margin="4,0" VerticalAlignment="Center"
                                       Foreground="{DynamicResource SubtleForegroundBrush}" />
                            <TextBox Width="58"
                                     Text="{Binding BatchResizeHeight, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </StackPanel>
                      </Grid>

                      <TextBlock Text="{DynamicResource Resize_Interpolation}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                      <ComboBox SelectedValue="{Binding BatchResizeKernel, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Resize_Cubic}" Tag="{x:Static filters:ResampleKernel.Bicubic}" />
                        <ComboBoxItem Content="{DynamicResource Resize_Bilinear}" Tag="{x:Static filters:ResampleKernel.Bilinear}" />
                        <ComboBoxItem Content="{DynamicResource Resize_Nearest}" Tag="{x:Static filters:ResampleKernel.NearestNeighbor}" />
                      </ComboBox>

                      <CheckBox Content="{DynamicResource Batch_OnlyShrink}" Margin="0,8,0,0"
                                IsChecked="{Binding BatchResizeOnlyShrink, Mode=TwoWay}"
                                Foreground="{DynamicResource ChromeForegroundBrush}" />
                    </StackPanel>

                    <!-- 基础调整 -->
                    <StackPanel Visibility="{Binding IsAdjustmentStepSelected, Converter={StaticResource BoolToVisibility}}">
                      <DockPanel LastChildFill="False">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Brightness}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                        <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                                   Style="{StaticResource StatusTextStyle}" Margin="0"
                                   Text="{Binding BatchAdjustBrightness, StringFormat={}{0:+0;-0;0}}" />
                      </DockPanel>
                      <Slider Minimum="-100" Maximum="100" TickFrequency="5"
                              Value="{Binding BatchAdjustBrightness, Mode=TwoWay}" />

                      <DockPanel LastChildFill="False" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Contrast}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                        <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                                   Style="{StaticResource StatusTextStyle}" Margin="0"
                                   Text="{Binding BatchAdjustContrast, StringFormat={}{0:+0;-0;0}}" />
                      </DockPanel>
                      <Slider Minimum="-100" Maximum="100" TickFrequency="5"
                              Value="{Binding BatchAdjustContrast, Mode=TwoWay}" />

                      <DockPanel LastChildFill="False" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Saturation}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                        <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                                   Style="{StaticResource StatusTextStyle}" Margin="0"
                                   Text="{Binding BatchAdjustSaturation, StringFormat={}{0:+0;-0;0}}" />
                      </DockPanel>
                      <Slider Minimum="-100" Maximum="100" TickFrequency="5"
                              Value="{Binding BatchAdjustSaturation, Mode=TwoWay}" />

                      <DockPanel LastChildFill="False" Margin="0,6,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Adjust_Temperature}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                        <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                                   Style="{StaticResource StatusTextStyle}" Margin="0"
                                   Text="{Binding BatchAdjustTemperature, StringFormat={}{0:+0;-0;0}}" />
                      </DockPanel>
                      <Slider Minimum="-100" Maximum="100" TickFrequency="5"
                              Value="{Binding BatchAdjustTemperature, Mode=TwoWay}" />
                    </StackPanel>

                    <!-- 翻转旋转 -->
                    <StackPanel Visibility="{Binding IsFlipRotateStepSelected, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{DynamicResource Batch_RotateCw}" Style="{StaticResource StatusLabelStyle}" />
                      <ComboBox SelectedValue="{Binding BatchRotateAngle, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Batch_RotateNone}" Tag="{x:Static filters:RotationAngle.None}" />
                        <ComboBoxItem Content="{DynamicResource Batch_Rotate90}" Tag="{x:Static filters:RotationAngle.Clockwise90}" />
                        <ComboBoxItem Content="{DynamicResource Batch_Rotate180}" Tag="{x:Static filters:RotationAngle.Clockwise180}" />
                        <ComboBoxItem Content="{DynamicResource Batch_Rotate270}" Tag="{x:Static filters:RotationAngle.Clockwise270}" />
                      </ComboBox>

                      <CheckBox Content="{DynamicResource Batch_FlipHorizontal}" Margin="0,8,0,0"
                                IsChecked="{Binding BatchFlipHorizontal, Mode=TwoWay}"
                                Foreground="{DynamicResource ChromeForegroundBrush}" />
                      <CheckBox Content="{DynamicResource Batch_FlipVertical}" Margin="0,6,0,0"
                                IsChecked="{Binding BatchFlipVertical, Mode=TwoWay}"
                                Foreground="{DynamicResource ChromeForegroundBrush}" />
                    </StackPanel>

                    <!-- 边框 -->
                    <StackPanel Visibility="{Binding IsBorderStepSelected, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{DynamicResource Batch_Style}" Style="{StaticResource StatusLabelStyle}" />
                      <ComboBox SelectedValue="{Binding BatchBorderStyle, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Batch_BorderSolid}" Tag="{x:Static filters:BorderStyle.Solid}" />
                        <ComboBoxItem Content="{DynamicResource Batch_BorderInset}" Tag="{x:Static filters:BorderStyle.InnerLine}" />
                        <ComboBoxItem Content="{DynamicResource Border_SoftShadow}" Tag="{x:Static filters:BorderStyle.Shadow}" />
                      </ComboBox>

                      <TextBlock Text="{DynamicResource Batch_BorderWidthPx}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                      <TextBox Text="{Binding BatchBorderWidth, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Text="{Binding BatchBorderColorText}" Margin="0,8,0,0" FontSize="11"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" />
                      <WrapPanel Margin="0,4,0,0">
                        <Button Content="{DynamicResource Common_WhiteShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchBorderColorWhite" />
                        <Button Content="{DynamicResource Common_BlackShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchBorderColorBlack" />
                        <Button Content="{DynamicResource Border_BeigeShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchBorderColorCream" />
                        <Button Content="{DynamicResource Common_GrayShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchBorderColorGray" />
                      </WrapPanel>
                    </StackPanel>

                    <!-- 文字水印 -->
                    <StackPanel Visibility="{Binding IsWatermarkStepSelected, Converter={StaticResource BoolToVisibility}}">
                      <TextBlock Text="{DynamicResource Batch_WatermarkText}" Style="{StaticResource StatusLabelStyle}" />
                      <TextBox Text="{Binding BatchWatermarkText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                      <TextBlock Text="{DynamicResource Batch_SizeMode}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                      <ComboBox SelectedValue="{Binding BatchWatermarkFontSizeMode, Mode=TwoWay}" SelectedValuePath="Tag">
                        <ComboBoxItem Content="{DynamicResource Batch_SizeRelative}"
                                      Tag="{x:Static batch:WatermarkSizeMode.RelativeToWidth}" />
                        <ComboBoxItem Content="{DynamicResource Batch_SizeFixed}" Tag="{x:Static batch:WatermarkSizeMode.Absolute}" />
                      </ComboBox>
                      <TextBlock Text="{DynamicResource Batch_SizeModeHint}"
                                 Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" />

                      <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                          <ColumnDefinition Width="*" />
                          <ColumnDefinition Width="8" />
                          <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                          <TextBlock Text="{DynamicResource Text_Size}" Style="{StaticResource StatusLabelStyle}" />
                          <TextBox Text="{Binding BatchWatermarkFontSize, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                          <TextBlock Text="{DynamicResource Batch_Margin}" Style="{StaticResource StatusLabelStyle}" />
                          <TextBox Text="{Binding BatchWatermarkMargin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </StackPanel>
                      </Grid>

                      <DockPanel LastChildFill="False" Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Batch_Opacity}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                        <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                                   Style="{StaticResource StatusTextStyle}" Margin="0"
                                   Text="{Binding BatchWatermarkOpacity}" />
                      </DockPanel>
                      <Slider Minimum="0" Maximum="255" TickFrequency="5"
                              Value="{Binding BatchWatermarkOpacity, Mode=TwoWay}" />

                      <StackPanel Visibility="{Binding IsBatchWatermarkTiled, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
                        <TextBlock Text="{DynamicResource Text_Position}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                        <ComboBox SelectedValue="{Binding BatchWatermarkAnchor, Mode=TwoWay}" SelectedValuePath="Tag">
                          <ComboBoxItem Content="{DynamicResource Anchor_TopLeft}" Tag="{x:Static filters:TextAnchor.TopLeft}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_TopCenter}" Tag="{x:Static filters:TextAnchor.TopCenter}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_TopRight}" Tag="{x:Static filters:TextAnchor.TopRight}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_MiddleLeft}" Tag="{x:Static filters:TextAnchor.MiddleLeft}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_Center}" Tag="{x:Static filters:TextAnchor.Center}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_MiddleRight}" Tag="{x:Static filters:TextAnchor.MiddleRight}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_BottomLeft}" Tag="{x:Static filters:TextAnchor.BottomLeft}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_BottomCenter}" Tag="{x:Static filters:TextAnchor.BottomCenter}" />
                          <ComboBoxItem Content="{DynamicResource Anchor_BottomRight}" Tag="{x:Static filters:TextAnchor.BottomRight}" />
                        </ComboBox>
                      </StackPanel>

                      <TextBlock Text="{DynamicResource Text_Layout}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                      <ComboBox SelectedIndex="{Binding BatchWatermarkLayoutIndex, Mode=TwoWay}">
                        <ComboBoxItem Content="{DynamicResource Text_LayoutSingle}" />
                        <ComboBoxItem Content="{DynamicResource Text_LayoutTile}" />
                      </ComboBox>

                      <!-- 平铺参数：只在平铺模式下出现 -->
                      <StackPanel Visibility="{Binding IsBatchWatermarkTiled, Converter={StaticResource BoolToVisibility}}">
                        <Grid Margin="0,8,0,0">
                          <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                          </Grid.ColumnDefinitions>
                          <StackPanel Grid.Column="0">
                            <TextBlock Text="{DynamicResource Text_TileSpacingX}" Style="{StaticResource StatusLabelStyle}" />
                            <TextBox Text="{Binding BatchTileSpacingX, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                          <StackPanel Grid.Column="2">
                            <TextBlock Text="{DynamicResource Text_TileSpacingY}" Style="{StaticResource StatusLabelStyle}" />
                            <TextBox Text="{Binding BatchTileSpacingY, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                          </StackPanel>
                        </Grid>

                        <DockPanel Margin="0,8,0,0" LastChildFill="False">
                          <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Text_TileAngle}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                          <TextBlock DockPanel.Dock="Right" MinWidth="46" TextAlignment="Right"
                                     Style="{StaticResource StatusTextStyle}" Margin="0"
                                     Text="{Binding BatchTileAngle, StringFormat={}{0:0}°}" />
                        </DockPanel>
                        <Slider Minimum="-75" Maximum="75" TickFrequency="5" SmallChange="1" LargeChange="5"
                                Value="{Binding BatchTileAngle, Mode=TwoWay}" />

                        <TextBlock Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource SubtleForegroundBrush}"
                                   Text="{DynamicResource Batch_TileHint}" />
                      </StackPanel>

                      <CheckBox Content="{DynamicResource Text_Bold}" Margin="0,8,0,0"
                                IsChecked="{Binding BatchWatermarkBold, Mode=TwoWay}"
                                Foreground="{DynamicResource ChromeForegroundBrush}" />
                      <CheckBox Content="{DynamicResource Batch_ShadowHint}" Margin="0,6,0,0"
                                IsChecked="{Binding BatchWatermarkShadow, Mode=TwoWay}"
                                Foreground="{DynamicResource ChromeForegroundBrush}" />

                      <TextBlock Text="{Binding BatchWatermarkColorText}" Margin="0,8,0,0" FontSize="11"
                                 Foreground="{DynamicResource SubtleForegroundBrush}" />
                      <WrapPanel Margin="0,4,0,0">
                        <Button Content="{DynamicResource Common_WhiteShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchWatermarkColorWhite" />
                        <Button Content="{DynamicResource Common_BlackShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchWatermarkColorBlack" />
                        <Button Content="{DynamicResource Common_GrayShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchWatermarkColorGray" />
                        <Button Content="{DynamicResource Common_YellowShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchWatermarkColorYellow" />
                        <Button Content="{DynamicResource Common_RedShort}" MinWidth="34" Style="{StaticResource ToolbarButtonStyle}"
                                Click="OnBatchWatermarkColorRed" />
                      </WrapPanel>
                    </StackPanel>

                  </StackPanel>
                </Border>

                <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource BorderBrush}" />

                <!-- ===== 3. 预览 ===== -->
                <TextBlock Text="{DynamicResource Batch_PreviewTitle}" Style="{StaticResource StatusLabelStyle}" />
                <Border Margin="0,6,0,0" MinHeight="88" BorderThickness="1"
                        BorderBrush="{DynamicResource BorderBrush}"
                        Background="{DynamicResource CheckerboardBrush}">
                  <Grid>
                    <Image Source="{Binding BatchPreviewImage}" Stretch="Uniform"
                           MaxHeight="210" Margin="4" />
                    <TextBlock Text="{DynamicResource Batch_PreviewHint}"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               FontSize="11" TextWrapping="Wrap" Margin="8"
                               Foreground="{DynamicResource SubtleForegroundBrush}"
                               Visibility="{Binding HasBatchPreviewImage, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}" />
                  </Grid>
                </Border>
                <TextBlock Text="{Binding BatchPreviewText}" Margin="0,6,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <Button Content="{DynamicResource Batch_RefreshPreview}" Margin="0,6,0,0" HorizontalAlignment="Left" MinWidth="74"
                        Style="{StaticResource ToolbarButtonStyle}"
                        Command="{Binding RefreshBatchPreviewCommand}" />

                <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource BorderBrush}" />

                <!-- ===== 4. 输出 ===== -->
                <TextBlock Text="{DynamicResource Batch_OutputTitle}" Style="{StaticResource StatusLabelStyle}" />

                <DockPanel Margin="0,6,0,0" LastChildFill="True">
                  <Button DockPanel.Dock="Right" Content="{DynamicResource Batch_Browse}" MinWidth="56" Margin="6,0,0,0"
                          Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding BrowseBatchOutputDirectoryCommand}" />
                  <TextBox Text="{Binding BatchOutputDirectory, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </DockPanel>

                <TextBlock Text="{DynamicResource Batch_Format}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                <ComboBox ItemsSource="{Binding BatchOutputFormatOptions}"
                          DisplayMemberPath="Name"
                          SelectedItem="{Binding BatchOutputFormat, Mode=TwoWay}" />

                <DockPanel LastChildFill="False" Margin="0,8,0,0">
                  <TextBlock DockPanel.Dock="Left" Text="{DynamicResource Batch_JpegQuality}" Style="{StaticResource StatusLabelStyle}" Margin="0" />
                  <TextBlock DockPanel.Dock="Right" MinWidth="40" TextAlignment="Right"
                             Style="{StaticResource StatusTextStyle}" Margin="0"
                             Text="{Binding BatchJpegQuality}" />
                </DockPanel>
                <Slider Minimum="1" Maximum="100" TickFrequency="1"
                        IsEnabled="{Binding IsBatchQualityEnabled}"
                        Value="{Binding BatchJpegQuality, Mode=TwoWay}" />

                <TextBlock Text="{DynamicResource Batch_FileNameSuffix}" Margin="0,8,0,0" Style="{StaticResource StatusLabelStyle}" />
                <TextBox Text="{Binding BatchFileNameSuffix, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />

                <TextBlock Text="{Binding BatchOutputSummary}" Margin="0,8,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
                <TextBlock Text="{Binding BatchTargetPathText}" Margin="0,4,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />

                <Rectangle Height="1" Margin="0,14" Fill="{DynamicResource BorderBrush}" />

                <!-- ===== 5. 执行 ===== -->
                <WrapPanel>
                  <Button Content="{DynamicResource Batch_Start}" MinWidth="104" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding StartBatchRunCommand}" />
                  <Button Content="{DynamicResource Common_Cancel}" MinWidth="54" Style="{StaticResource ToolbarButtonStyle}"
                          Command="{Binding CancelBatchRunCommand}" />
                </WrapPanel>

                <TextBlock Text="{Binding BatchRunProgressText}" Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource AccentBrush}" />

                <ProgressBar Height="6" Margin="0,6,0,0" Minimum="0" Maximum="100"
                             Value="{Binding ProgressValue, Mode=OneWay}"
                             Visibility="{Binding IsBatchRunning, Converter={StaticResource BoolToVisibility}}" />

                <TextBlock Text="{DynamicResource Batch_NoUndo}"
                           Margin="0,10,0,0" FontSize="11" TextWrapping="Wrap"
                           Foreground="{DynamicResource SubtleForegroundBrush}" />
              </StackPanel>
            </ScrollViewer>
          </TabItem>
        </TabControl>
      </Border>
    </Grid>

    <!-- ==================== 状态栏 ==================== -->
    <Border Grid.Row="4"
            Background="{DynamicResource StatusBarBackgroundBrush}"
            BorderBrush="{DynamicResource BorderBrush}"
            BorderThickness="0,1,0,0">
      <Grid Margin="4,3">
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*" />
          <ColumnDefinition Width="Auto" />
          <ColumnDefinition Width="Auto" />
        </Grid.ColumnDefinitions>

        <TextBlock Grid.Column="0"
                   Style="{StaticResource StatusTextStyle}"
                   Text="{Binding StatusText}"
                   ToolTip="{Binding StatusText}" />

        <!-- 进度反馈：只有耗时操作（>200ms）才会显示（需求 P3-15） -->
        <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"
                    Margin="8,0"
                    Visibility="{Binding IsProgressVisible, Converter={StaticResource BoolToVisibility}}">
          <ProgressBar Width="140" Height="8" Minimum="0" Maximum="100"
                       Value="{Binding ProgressValue, Mode=OneWay}" />
          <TextBlock Text="{Binding ProgressText}" Margin="8,0,0,0" FontSize="11"
                     VerticalAlignment="Center"
                     Foreground="{DynamicResource AccentBrush}" />
        </StackPanel>

        <StackPanel Grid.Column="2" Orientation="Horizontal">
          <TextBlock Style="{StaticResource StatusLabelStyle}" Text="{DynamicResource Resize_Size}" />
          <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding PixelSizeText}" />
          <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" Margin="4,5" />
          <TextBlock Style="{StaticResource StatusLabelStyle}" Text="DPI" />
          <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding DpiText}" />
          <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" Margin="4,5" />
          <TextBlock Style="{StaticResource StatusLabelStyle}" Text="{DynamicResource Batch_File}" />
          <TextBlock Style="{StaticResource StatusTextStyle}" Text="{Binding FileSizeText}" />
          <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" Margin="4,5" />
          <TextBlock Style="{StaticResource StatusLabelStyle}" Text="{DynamicResource Print_Scale}" />
          <TextBlock Style="{StaticResource ZoomTextStyle}" Text="{Binding ZoomPercentText}" />
          <Rectangle Style="{StaticResource ToolbarSeparatorStyle}" Margin="4,5" />
          <TextBlock Style="{StaticResource StatusLabelStyle}" Text="{Binding HistoryText}"
                     ToolTip="{Binding HistoryText}" />
        </StackPanel>
      </Grid>
    </Border>
  </Grid>
</Window>
